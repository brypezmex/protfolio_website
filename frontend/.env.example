# ---------------------------------------------------------------------------
# Frontend environment variables
#
# Copy to `.env` (git-ignored) and edit. Only variables prefixed with VITE_ are
# exposed to the browser bundle, so NEVER put a secret in this file. Anything
# here ends up readable in the shipped JavaScript.
#
# Every variable is optional. With none of them set, the site builds and runs as
# a fully static portfolio with placeholder project links.
# ---------------------------------------------------------------------------

# Base URL for the Flask API.
# Leave blank to use same-origin relative requests (`/api/...`), which is what
# you want when nginx serves the frontend and reverse-proxies /api on the same
# host. Set an absolute URL only when the API lives on a different origin.
VITE_API_BASE_URL=

# Target the Vite dev server proxies /api to during `npm run dev`.
VITE_DEV_API_PROXY=http://127.0.0.1:5001

# Master switch for anything that talks to the backend. When false, the app
# never issues an API request and hides the GitHub stats and live
# status badges. Useful for static-only hosting (GitHub Pages, Netlify).
VITE_ENABLE_BACKEND=true

# ---------------------------------------------------------------------------
# Project links
#
# These override the `links` values in src/data/projects.js at runtime, so you
# can point demos at your home server without editing source. Naming convention:
#   VITE_PROJECT_<ID>_GITHUB / VITE_PROJECT_<ID>_DEMO
# where <ID> is the uppercased project `id` from projects.js.
# ---------------------------------------------------------------------------

VITE_PROJECT_NOIRMORE_GITHUB=
VITE_PROJECT_NOIRMORE_DEMO=

VITE_PROJECT_WOLFCAFE_GITHUB=
VITE_PROJECT_WOLFCAFE_DEMO=

# ---------------------------------------------------------------------------
# Resume
# ---------------------------------------------------------------------------

# Path (or absolute URL) to the resume PDF. The default resolves to the file at
# frontend/public/resume/resume.pdf.
VITE_RESUME_URL=/resume/resume.pdf
