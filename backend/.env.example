# ---------------------------------------------------------------------------
# Backend environment
#
# Copy to backend/.env (git-ignored) and edit. Unlike the frontend .env, this
# file holds real secrets - it is read by the server process and nothing in it
# is ever sent to a browser.
#
# The API is optional. With every feature below switched off, the portfolio
# still works as a fully static site.
# ---------------------------------------------------------------------------

# --- Server ----------------------------------------------------------------

HOST=127.0.0.1
PORT=5001
FLASK_DEBUG=false

# Comma-separated browser origins allowed to call this API.
# Leave EMPTY when nginx serves the frontend and proxies /api on the same host -
# that is same-origin and needs no CORS headers at all.
# Set it only when the frontend is on a different origin, e.g.:
#   ALLOWED_ORIGINS=https://bryanperez.dev,http://localhost:5173
ALLOWED_ORIGINS=

# --- Feature switches ------------------------------------------------------
# Each is independent. The frontend reads these (as booleans, via /api/config)
# and hides the matching UI when a feature is off.

ENABLE_GITHUB=true
ENABLE_STATUS=true

# --- GitHub ----------------------------------------------------------------

GITHUB_USER=brypezmex

# Optional. Without a token GitHub allows 60 requests per hour per IP, which is
# ample given responses are cached for 15 minutes. Create a fine-grained token
# with PUBLIC REPOSITORY READ-ONLY access and nothing else.
GITHUB_TOKEN=

# Which repository backs which project card.
# Format: <project id from frontend/src/data/projects.js>=<owner>/<repo>
# Leave empty to disable the GitHub feature without changing ENABLE_GITHUB.
GITHUB_REPOS=noirmore=brypezmex/NoirMore,wolfcafe=brypezmex/WolfCafe

GITHUB_CACHE_TTL=900

# --- Home server: project demo status --------------------------------------
#
# One variable per project, named PROJECT_SERVICE_<KEY> where <KEY> is the
# uppercased `service.key` from frontend/src/data/projects.js.
#
# These URLs stay on the server. The browser sends only the key and receives
# only "online" / "offline" / "unconfigured", so the home server's address is
# never present in the published JavaScript bundle.
#
# Point them at a cheap health endpoint rather than the app's front page.

# PROJECT_SERVICE_NOIRMORE=http://10.0.0.42:8081/health
# PROJECT_SERVICE_WOLFCAFE=http://10.0.0.42:8082/actuator/health

STATUS_CACHE_TTL=60
STATUS_TIMEOUT=3
