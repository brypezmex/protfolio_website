# ---- Secrets -------------------------------------------------------------
# .env files hold API keys and home server addresses. Only .env.example is
# tracked. Never remove these lines.
.env
.env.*
!.env.example

# ---- Node ----------------------------------------------------------------
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vite/

# ---- Python --------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Editors and OS ------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp

# ---- Logs ----------------------------------------------------------------
*.log
logs/
